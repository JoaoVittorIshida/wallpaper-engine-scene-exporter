<Window x:Class="WallpaperSceneExporter.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações — Wallpaper Engine Scene Exporter" Icon="/Assets/app.ico" Width="650" Height="720" MinWidth="600" MinHeight="620"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
        <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,7,0,0" /></Style>
        <Style x:Key="OutputChoice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource DropBorderBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="84" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusStyle}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="ChoiceChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="16,14"><ContentPresenter VerticalAlignment="Center" /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ChoiceChrome" Property="Background" Value="{StaticResource PanelRaisedBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="ChoiceChrome" Property="Background" Value="{StaticResource AccentSurfaceBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="ChoiceChrome" Property="BorderThickness" Value="2" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="34,30">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition Height="*" /><RowDefinition Height="20" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Configurações" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Escolha como seu arquivo será criado." Foreground="{StaticResource MutedTextBrush}" FontSize="14" Margin="0,6,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22">
                    <StackPanel>
                        <TextBlock Text="Formato" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Escolha entre animação e vídeo." Style="{StaticResource Hint}" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <RadioButton GroupName="OutputFormat" IsChecked="{Binding IsGifOutput}" Style="{StaticResource OutputChoice}" AutomationProperties.Name="Criar GIF">
                                <StackPanel><TextBlock Text="GIF" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Animação fácil de compartilhar" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            </RadioButton>
                            <RadioButton Grid.Column="2" GroupName="OutputFormat" IsChecked="{Binding IsMp4Output}" Style="{StaticResource OutputChoice}" AutomationProperties.Name="Criar vídeo">
                                <StackPanel><TextBlock Text="Vídeo" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="Mais detalhes em arquivo menor" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Aparência" Style="{StaticResource SectionTitle}" />
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Duração" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding DurationSeconds, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Duração em segundos" /><TextBlock Text="Em segundos" Style="{StaticResource Hint}" /></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Qualidade do GIF" Style="{StaticResource FieldLabel}" />
                                <ComboBox SelectedValue="{Binding QualityPreset}" SelectedValuePath="Tag" IsEnabled="{Binding IsGifOutput}" AutomationProperties.Name="Qualidade do GIF">
                                    <ComboBoxItem Content="Arquivo menor" Tag="compact" /><ComboBoxItem Content="Equilibrada" Tag="high" /><ComboBoxItem Content="Mais detalhes" Tag="maximum" />
                                </ComboBox><TextBlock Text="{Binding QualityHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,18,0,0">
                            <TextBlock Text="Tamanho" Style="{StaticResource FieldLabel}" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="38" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Width, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Largura" />
                                <TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                                <TextBox Grid.Column="2" Text="{Binding Height, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Altura" />
                            </Grid>
                            <TextBlock Text="Use o tamanho da tela onde a animação será exibida." Style="{StaticResource Hint}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}" />
                        <CheckBox Content="Converter assim que uma cena for adicionada" IsChecked="{Binding AutoProcess}" Margin="0,15,0,0" />
                        <TextBlock Text="Você ainda poderá cancelar enquanto o arquivo estiver sendo criado." Style="{StaticResource Hint}" Margin="28,2,0,0" />
                    </StackPanel>
                </Border>

                <Expander Header="Ajuda para localizar aplicativos" Margin="0,16,0,0" Foreground="{StaticResource MutedTextBrush}">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="22" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="O Scene Exporter encontra o necessário sozinho. Use estas opções apenas se a verificação falhar." Style="{StaticResource Hint}" Margin="0" />
                            <StackPanel Margin="0,18,0,0"><TextBlock Text="Aplicativo de cenas" Style="{StaticResource FieldLabel}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding WallpaperEnginePath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Local do aplicativo de cenas" />
                                    <Button Grid.Column="2" Content="Procurar" Command="{Binding BrowseWallpaperEngineCommand}" MinWidth="100" />
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0"><TextBlock Text="Conversor de mídia" Style="{StaticResource FieldLabel}" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding FfmpegPath, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Local do conversor de mídia" />
                                    <Button Grid.Column="2" Content="Procurar" Command="{Binding BrowseFfmpegCommand}" MinWidth="100" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Border Background="{StaticResource ErrorSurfaceBrush}" CornerRadius="10" Padding="13" Margin="0,16,0,0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Content="Cancelar" Command="{Binding CancelCommand}" IsCancel="True" />
            <Button Grid.Column="2" Content="Salvar" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </Grid>
    </Grid>
</Window>
