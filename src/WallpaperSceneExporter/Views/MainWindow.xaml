<Window x:Class="WallpaperSceneExporter.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:WallpaperSceneExporter.Models"
        Title="{Binding WindowTitle}" Icon="/Assets/app.ico" Width="820" Height="680"
        MinWidth="720" MinHeight="620" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="42,34,42,38">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/brand-mark.png" Width="48" Height="48" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="Logo do Wallpaper Engine Scene Exporter" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wallpaper Engine Scene Exporter" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Grave cenas do Wallpaper Engine em GIF ou vídeo" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,3,0,0" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Content="Configurações" Command="{Binding OpenSettingsCommand}" Style="{StaticResource QuietButton}"
                    ToolTip="Ajustar formato, duração e tamanho" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="*" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="20,17">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PanelRaisedBrush}" Margin="0,0,13,0">
                        <Ellipse Width="9" Height="9">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:PipelineState.Waiting}"><Setter Property="Fill" Value="{StaticResource MutedTextBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:PipelineState.Completed}"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="{x:Static models:PipelineState.Error}"><Setter Property="Fill" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Status da conversão" />
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" Margin="0,9,0,0" AutomationProperties.Name="Progresso">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="DropZone" Grid.Row="2" Background="{StaticResource DropZoneBrush}" BorderBrush="{StaticResource DropBorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="20" AllowDrop="True"
                    DragEnter="OnDragEnter" DragLeave="OnDragLeave" Drop="OnDrop"
                    AutomationProperties.Name="Área para adicionar uma cena">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="450">
                    <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource PanelRaisedBrush}" HorizontalAlignment="Center">
                        <Grid>
                            <Path Data="M 15,28 L 41,28 M 28,15 L 28,41" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding InputFileText}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,12,0,0" />
                    <TextBlock Text="Arraste para cá ou escolha no computador" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="14" TextAlignment="Center" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <Button Content="Escolher cena" Command="{Binding ChooseSceneCommand}" Margin="0,12,0,0" HorizontalAlignment="Center" MinWidth="154" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="{Binding PrimaryActionText}" Command="{Binding StartCommand}" IsEnabled="{Binding CanStart}" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" AutomationProperties.HelpText="Cria o arquivo no formato escolhido" />
                <Button Grid.Column="2" Content="Cancelar" Command="{Binding CancelCommand}" IsEnabled="{Binding CanCancel}"
                        Style="{StaticResource DangerButton}" MinWidth="112" />
            </Grid>
        </Grid>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PresetText}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" />
                <TextBlock Text="  ·  " Foreground="{StaticResource SubtleTextBrush}" />
                <TextBlock Text="{Binding CaptureSummary}" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Content="Abrir resultados" Command="{Binding OpenOutputCommand}" Style="{StaticResource TextButton}"
                    ToolTip="Ver arquivos concluídos" />
        </Grid>
    </Grid>
</Window>
